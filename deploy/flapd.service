# systemd unit for flapd, the Flap SSH game server.
# Installed to /etc/systemd/system/flapd.service by deploy/install.sh.
# Check the effective sandbox with: systemd-analyze security flapd.service

[Unit]
Description=Flap SSH game server
Documentation=file:/usr/local/share/doc/flapd/OPERATIONS.md
After=network-online.target
Wants=network-online.target
# Give up after 10 failed starts in 5 minutes instead of looping forever.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=notify
NotifyAccess=main
User=flapd
Group=flapd
ExecStartPre=/usr/local/bin/flapd check-config -config /etc/flapd/flapd.toml
ExecStart=/usr/local/bin/flapd serve -config /etc/flapd/flapd.toml
# SIGHUP reloads the authorised keys file (auth.mode = "allowlist").
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
# Back off exponentially from 2s to 60s between restarts. RestartSteps and
# RestartMaxDelaySec need systemd 254+; older versions ignore them and use
# RestartSec only.
RestartSec=2s
RestartSteps=6
RestartMaxDelaySec=60s
TimeoutStartSec=30s
# Covers server.shutdown_grace (10s by default) plus run saving.
TimeoutStopSec=30s
KillSignal=SIGTERM
KillMode=mixed

# Files: /var/lib/flapd (host key, identity secret, database) is the only
# writable location; /etc/flapd is readable.
StateDirectory=flapd
StateDirectoryMode=0700
ConfigurationDirectory=flapd
ConfigurationDirectoryMode=0750
WorkingDirectory=/var/lib/flapd
UMask=0077

# Resource limits. Keep GOMEMLIMIT below MemoryMax so the Go garbage
# collector works harder before the kernel would kill the service.
MemoryMax=384M
Environment=GOMEMLIMIT=300MiB
CPUQuota=100%
TasksMax=128
LimitNOFILE=4096
LimitCORE=0

# Sandbox.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
PrivateUsers=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
KeyringMode=private
DevicePolicy=closed
# TCP for players, AF_UNIX for the journal and sd_notify.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
